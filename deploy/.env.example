# Copy to paper_discord_bot/.env beside the Dockerfile, then enter the real values.
PUBLIC_URL=https://paper.example.com

DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=
# 자동 공지가 필요한 서버만 Discord에서 /setup을 실행합니다.

TIME_ZONE=Asia/Seoul
DAILY_RELEASE_HOUR=9
READING_MINUTES=30
WRITING_MINUTES=20
CODEX_MODEL=gpt-5.6-terra
CODEX_TIMEOUT_SECONDS=180

ARXIV_ENABLED=true
ARXIV_POOL_TARGET=7
ARXIV_LOOKBACK_DAYS=365
ARXIV_USER_AGENT=PaperLeague/0.1 (private daily research reading app)

# NODE_ENV, DEMO_MODE, HOST, PORT, DATA_DIR, CODEX_HOME and TRUST_PROXY_HOPS
# are set in the paper-league service in your existing integrated Compose file.

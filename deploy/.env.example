# Copy to the project root as .env, then enter the real values.
# Name of the EXISTING Docker network shared with your Nginx container.
NGINX_NETWORK=proxy
PUBLIC_URL=https://paper.example.com

DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_ROLE_ID=

TIME_ZONE=Asia/Seoul
DAILY_RELEASE_HOUR=9
READING_MINUTES=30
WRITING_MINUTES=20
CODEX_MODEL=gpt-5.6-terra
CODEX_TIMEOUT_SECONDS=180

ARXIV_ENABLED=true
ARXIV_POOL_TARGET=7
ARXIV_LOOKBACK_DAYS=365
ARXIV_USER_AGENT=PaperLeague/0.1 (private daily research reading app)

# NODE_ENV, DEMO_MODE, HOST, PORT, DATA_DIR, CODEX_HOME and TRUST_PROXY_HOPS
# are set by compose.yaml so local-development settings cannot override them.

# Copy to paper_discord_bot/.env beside the Dockerfile, then enter the real values.
PUBLIC_URL=https://paper.example.com

DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=
# 자동 공지가 필요한 서버만 Discord에서 /setup을 실행합니다.

TIME_ZONE=Asia/Seoul
DAILY_RELEASE_HOUR=9
READING_MINUTES=30
WRITING_MINUTES=20
CODEX_MODEL=gpt-6-astra
CODEX_TIMEOUT_SECONDS=300

# 논문 수집 후 기존 Codex OAuth로 한국어 번역을 자동 생성합니다.
# 모델 생략 시 CODEX_MODEL 사용. 번역을 모두 준비한 뒤 읽기를 시작합니다.
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=gpt-6-astra
TRANSLATION_TIMEOUT_SECONDS=900

ARXIV_ENABLED=true
ARXIV_POOL_TARGET=7
ARXIV_LOOKBACK_DAYS=365
ARXIV_USER_AGENT=PaperLeague/0.1 (private daily research reading app)

# 논문 1편당 상대 가중치. arXiv의 게재/채택 표기로 분류합니다 (각각 1~100).
PAPER_WEIGHT_PREFERRED=5
PAPER_WEIGHT_PUBLISHED=2
PAPER_WEIGHT_UNCONFIRMED=1
# 생략하면 여러 분야의 기본 우선 목록. 지정하면 해당 목록 전체를 교체합니다.
# PAPER_PREFERRED_VENUES=NeurIPS,ICML,ICLR,CVPR,Nature,Science,Physical Review Letters,Annals of Mathematics

# NODE_ENV, DEMO_MODE, HOST, PORT, DATA_DIR, CODEX_HOME and TRUST_PROXY_HOPS
# are set in the paper-league service in your existing integrated Compose file.

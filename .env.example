# npm run demo works without credentials. Copy this file to .env for Discord operation.
NODE_ENV=development
DEMO_MODE=false
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=data/production
TRUST_PROXY_HOPS=0

# Discord Developer Portal application. Never paste secrets into chat.
DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Optional: restrict participation to this role in the configured guild.
DISCORD_ALLOWED_ROLE_ID=

TIME_ZONE=Asia/Seoul
DAILY_RELEASE_HOUR=9
READING_MINUTES=30
WRITING_MINUTES=20

# Official Codex SDK uses the server operator's codex login session.
CODEX_MODEL=gpt-5.6-terra
CODEX_TIMEOUT_SECONDS=180

# No category restriction: sample arXiv across all subjects.
# Automatic import only admits CC BY or CC0 papers whose license was verified.
ARXIV_ENABLED=true
ARXIV_POOL_TARGET=7
ARXIV_LOOKBACK_DAYS=365
ARXIV_USER_AGENT=PaperLeague/0.1 (private daily research reading app)
